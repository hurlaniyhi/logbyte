{
  "name": "@rhydhur/logbyte",
  "version": "0.1.1",
  "description": "Tiny structured logging client for logbyte — send info/warning/error logs from any JavaScript app (Node.js backends or frontend frameworks like React and Vue) to your logbyte dashboard.",
  "keywords": ["logging", "logger", "logbyte", "observability", "react", "vue", "javascript"],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
